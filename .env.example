# ---------------------------------------------------------
# LEARNUP ENVIRONMENT CONFIGURATION
# ---------------------------------------------------------
# Local Development:
# Do not edit this file directly.
# Run `npm run setup` (or setup.bat / setup.sh) to automatically
# generate `.env.local` connected to your local Docker Supabase.
#
# Hosted SaaS Production (Vercel, etc.):
# Supply these variables directly in your deployment platform.
# Never commit production secrets to Git.
# ---------------------------------------------------------

# REQUIRED: Supabase Public Configuration
# For local dev, this will be http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# REQUIRED: Supabase Public Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# REQUIRED: YouTube Integration
# Server-side only - never expose to client
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
